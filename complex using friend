#include <iostream>
using namespace std;

class Complex {
public:
    int real;
    int imag;

    // Constructor
    Complex() : real(0), imag(0) {}

    // Method to input complex number
    void input() {
        cout << "Enter value of real part: ";
        cin >> real;
        cout << "Enter value of imaginary part: ";
        cin >> imag;
    }

    // Method to display complex number
    void display() const {
        cout << "Complex number is " << real << " + " << imag << "i" << endl;
    }

    // Friend functions for arithmetic operations
    friend Complex operator+(const Complex &a, const Complex &b);
    friend Complex operator-(const Complex &a, const Complex &b);
    friend Complex operator*(const Complex &a, const Complex &b);
    friend Complex operator/(const Complex &a, const Complex &b);
};

// Definition of friend functions

Complex operator+(const Complex &a, const Complex &b) {
    Complex temp;
    temp.real = a.real + b.real;
    temp.imag = a.imag + b.imag;
    return temp;
}

Complex operator-(const Complex &a, const Complex &b) {
    Complex temp;
    temp.real = a.real - b.real;
    temp.imag = a.imag - b.imag;
    return temp;
}

Complex operator*(const Complex &a, const Complex &b) {
    Complex temp;
    temp.real = a.real * b.real - a.imag * b.imag;
    temp.imag = a.real * b.imag + a.imag * b.real;
    return temp;

}
Complex operator/(const Complex &a, const Complex &b) {
    Complex temp;
    int denominator = b.real * b.real + b.imag * b.imag; // Calculate denominator
    if (denominator == 0) {
        throw invalid_argument("Division by zero exception");
    }
    temp.real = (a.real * b.real + a.imag * b.imag) / denominator; // Real part
    temp.imag = (a.imag * b.real - a.real * b.imag) / denominator; // Imaginary part
    return temp;
}


int main() {
    Complex obj1, obj2, obj3;
    
    cout << "Input for first complex number:" << endl;
    obj1.input();
    
    cout << "Input for second complex number:" << endl;
    obj2.input();

    obj3 = obj1 + obj2;
    cout << "Addition: ";
    obj3.display();

    obj3 = obj1 - obj2;
    cout << "Subtraction: ";
    obj3.display();

    obj3 = obj1 * obj2;
    cout << "Multiplication: ";
    obj3.display();

    obj3 = obj1 / obj2;
    cout << "Division: ";
    obj3.display();

    return 0;
}
